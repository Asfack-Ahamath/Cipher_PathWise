# PathWise configuration. Copy to .env (never commit .env). Every value has a safe default for the local demo.
# Full Supabase walkthrough: docs/supabase.md

# ── Database ────────────────────────────────────────────────────────────────
# Local / docker compose: the bundled PostgreSQL.
DATABASE_URL=postgres://pathwise:pathwise@localhost:5432/pathwise
# Supabase: Project → Connect → "Session pooler" string (port 5432), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Managed databases need TLS:
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# docker compose only: credentials of its own PostgreSQL container
POSTGRES_USER=pathwise
POSTGRES_PASSWORD=pathwise
POSTGRES_DB=pathwise

# ── Security ────────────────────────────────────────────────────────────────
# Signs session tokens. REQUIRED (32+ random characters) when DEMO_MODE=false:  openssl rand -base64 48
JWT_SECRET=change-me-in-production-at-least-32-chars
# Browser origins allowed to call the API from another domain (comma-separated). Empty = same origin only.
CORS_ORIGINS=
# Behind a hosting proxy (Render, Fly, Railway): trust X-Forwarded-For for rate limits and audit IPs.
TRUST_PROXY=false
# Public URL of the app (used as the redirect in password-reset emails)
APP_URL=http://localhost:3000

# ── Sign-in and files: local or Supabase ────────────────────────────────────
# local    = passwords checked with bcrypt in the users table
# supabase = passwords checked by Supabase Auth (accounts are created there by the seed and the admin screens)
AUTH_PROVIDER=local
# db       = photos and signatures stored in PostgreSQL
# supabase = photos in a private Supabase Storage bucket, served through short-lived signed URLs
STORAGE_PROVIDER=db
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only secret. Never put it in the web app or in git.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pathwise-proofs

# ── First administrator (created on the first start) ───────────────────────
ADMIN_EMAIL=admin@pathwise.lk
# Leave empty in demo mode (uses DEMO_PASSWORD). Outside demo mode an empty value means the admin must change it at first sign-in.
ADMIN_PASSWORD=

# ── Demo ────────────────────────────────────────────────────────────────────
# true  = seeded demo accounts, the demo day (Thu 30 Apr 2026), demo clock and "Reset demo day" (for judging)
# false = real rollout: only the administrator is created; demo clock and reset are disabled
DEMO_MODE=true
# Create tables and load data on the first start (only when the database is empty)
SEED_ON_START=true
DEMO_CLOCK_START=2026-04-30T02:30:00+05:30
DEMO_PASSWORD=PathWise@2026
# Folder with the official dataset CSVs (optional; a bundled copy is used otherwise)
# DATA_DIR=./data

# ── Server ──────────────────────────────────────────────────────────────────
APP_PORT=3000
PORT=3000
LOG_LEVEL=info
