# Copy to .env and change as needed. docker compose works without it (these are the defaults).

# Database (the "db" service in docker-compose.yml)
POSTGRES_USER=pathwise
POSTGRES_PASSWORD=pathwise
POSTGRES_DB=pathwise

# Used when you run the API outside Docker (npm run dev). Inside Docker compose builds this for you.
DATABASE_URL=postgres://pathwise:pathwise@localhost:5432/pathwise

# Sign the login tokens. Use a long random value in production.
JWT_SECRET=change-me-in-production-at-least-32-chars

# Port on your machine for the app (compose) / the API (npm run dev)
APP_PORT=8080
PORT=8080

# Create tables and load the demo delivery day on first start (only when the database is empty)
SEED_ON_START=true

# The business clock starts here on seed/reset (Sri Lanka time) and then runs in real time
DEMO_CLOCK_START=2026-04-30T02:30:00+05:30

# Password for every seeded account
DEMO_PASSWORD=PathWise@2026

LOG_LEVEL=info

# Set to true for managed Postgres that requires TLS (Neon, Supabase, Railway public URL)
DATABASE_SSL=false
